VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=

# Use "mock" for deterministic local development or "production" for live adapters.
VITE_DATA_MODE=production

# Server-only tuning. Browser users cannot read these values.
INCIDENT_MAX_BBOX_DEGREES=5
INCIDENT_PROVIDER_TIMEOUT_MS=8000
# Per-instance burst limit for /api/v1/incidents (requests per client per minute).
INCIDENT_RATE_LIMIT_PER_MINUTE=60

# Restrict the browser key by HTTP referrer and to Maps JavaScript API,
# Routes API, and Places API (New). VITE_* values are public browser config.
